# Copy to deploy/.env.production on the server and fill in. Never commit the real file.
APP_DOMAIN=fte.codecraftai.net
API_DOMAIN=api-fte.codecraftai.net

POSTGRES_PASSWORD=
# 32+ random chars:  openssl rand -hex 32
SECRET_KEY=
# Fernet key:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# AI chatbot / content (Google Gemini)
GEMINI_API_KEY=
LLM_API_KEY=

# Google login (optional; same client id is used by frontend and backend)
GOOGLE_CLIENT_ID=

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Store integrations (optional)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
